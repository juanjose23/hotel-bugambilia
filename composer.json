{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "hotel-bugambilia/gestion-hotelera",
    "description": "Sistema de gestión integral para Hotel Bugambilia: inventario, activos y limpieza.",
    "type": "project",
    "keywords": [
        "hotel",
        "laravel",
        "filament",
        "gestion-hotelera"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Juan Huete",
            "email": "jrios9836@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4.1",
        "ext-pdo": "*",
        "afatmustafa/blade-hugeicons": "^2.0",
        "barryvdh/laravel-dompdf": "^3.1",
        "bezhansalleh/filament-shield": "^4.2",
        "codeat3/blade-google-material-design-icons": "^1.21",
        "filament/filament": "^5.6",
        "inertiajs/inertia-laravel": "^3.1",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "owen-it/laravel-auditing": "^14.0",
        "picqer/php-barcode-generator": "^3.2",
        "qalainau/filament-univer-sheet": "^1.1",
        "stripe/stripe-php": "^21.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laramint/laravel-brain": "^2.3",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.2",
        "laravel/dusk": "^8.6",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "laraveldaily/filacheck": "^1.2",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Maatwebsite\\": "stubs/Maatwebsite/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run lint:check",
            "npm run format:check",
            "npm run types:check",
            "@test"
        ],
        "phpstan": [
            "phpstan analyse --level=9 --memory-limit=1G"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "npm run types:check",
            "@php artisan test"
        ],
        "dusk:setup": [
            "@php artisan migrate:fresh --env=dusk --ansi",
            "@php artisan db:seed --class=Database\\Seeders\\DuskSeeder --env=dusk --ansi"
        ],
        "dusk": [
            "@php artisan dusk"
        ],
        "dusk:fails": [
            "@php artisan dusk --without-tty"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable"
}
