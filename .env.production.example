# Valores para el panel de Coolify/Dokploy. No contiene credenciales reales.
HOTEL_IMAGE=ghcr.io/juanjose23/hotel-bugambilia:production
APP_KEY=
APP_URL=https://hotel.example.com
# Sustituir por la IP o CIDR real del proxy interno, sin usar *.
TRUSTED_PROXIES=172.16.0.0/12
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
TESORERIA_HABILITADO=true
