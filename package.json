{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "prepare": "husky",
        "format:js": "prettier --write \"resources/js/**/*.{js,jsx,ts,tsx,vue}\" \"vite.config.js\"",
        "check:prettier": "prettier --check \"resources/js/**/*.{js,jsx,ts,tsx,vue}\" \"vite.config.js\""
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.2",
        "@commitlint/config-conventional": "^20.5.0",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "eslint": "^10.2.1",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^3.0.0",
        "prettier": "^3.8.3",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
}
