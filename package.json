{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "check:prettier": "prettier --check resources/",
        "lint": "eslint resources/js scripts .husky/install.mjs --fix",
        "lint:check": "eslint resources/js scripts .husky/install.mjs",
        "lint:php": "vendor/bin/pint --test",
        "types:check": "tsc --noEmit",
        "phpstan": "vendor/bin/phpstan analyse --level=9 --memory-limit=1G",
        "test:php": "node scripts/project.mjs test",
        "test:k6": "k6 run tests/k6/scenarios/05_regression_suite.js",
        "test:k6:smoke": "k6 run tests/k6/scenarios/01_smoke_landing.js",
        "test:k6:reserva": "k6 run tests/k6/scenarios/02_reserva_flow.js",
        "test:k6:restaurante": "k6 run tests/k6/scenarios/03_restaurante_pos.js",
        "test:k6:auth": "k6 run tests/k6/scenarios/04_auth_registro.js",
        "test:stress": "vendor/bin/pest stress http://localhost",
        "prepare": "node .husky/install.mjs",
        "check": "node scripts/project.mjs check",
        "test": "node scripts/project.mjs test",
        "test:dusk": "node scripts/project.mjs dusk"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.3.2",
        "@types/node": "^22.13.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.0",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "sharp": "^0.35.3",
        "tailwindcss": "^4.3.2",
        "typescript-eslint": "^8.23.0"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@hookform/resolvers": "^5.9.1",
        "@inertiajs/react": "^3.6.1",
        "@inertiajs/vite": "^3.0.0",
        "@radix-ui/react-accordion": "^1.2.15",
        "@radix-ui/react-checkbox": "^1.3.6",
        "@radix-ui/react-popover": "^1.1.18",
        "@radix-ui/react-scroll-area": "^1.2.13",
        "@radix-ui/react-select": "^2.3.2",
        "@radix-ui/react-separator": "^1.1.11",
        "@radix-ui/react-slot": "^1.3.0",
        "@radix-ui/react-tabs": "^1.1.16",
        "@stripe/stripe-js": "^9.14.0",
        "@tanstack/react-query": "^5.102.8",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "date-fns": "^4.4.0",
        "driver.js": "1.4.0",
        "embla-carousel-react": "^8.6.0",
        "globals": "^15.14.0",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^3.1",
        "lucide-react": "^1.23.0",
        "react": "^19.2.0",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.0",
        "react-hook-form": "^7.86.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.0.1",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5.7.2",
        "vite": "^8.0.0",
        "zustand": "^5.0.14"
    },
    "engines": {
        "node": ">=22.12.0",
        "npm": ">=10"
    }
}
